{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wellmanifest/reuse/schemas/stream-flow.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "version",
    "stages"
  ],
  "properties": {
    "schema": {
      "const": "wellmanifest.stream-flow/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "tier",
          "weight",
          "outcome"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "floor",
              "standard",
              "opportunistic"
            ]
          },
          "weight": {
            "type": "number"
          },
          "when": {
            "type": "string"
          },
          "satisfied_when": {
            "type": "string"
          },
          "outcome": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "capability",
          "tier",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "tier": {
            "enum": [
              "floor",
              "standard",
              "opportunistic"
            ]
          },
          "weight": {
            "type": "number"
          },
          "fallback_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "tier",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "module",
              "component",
              "process"
            ]
          },
          "tier": {
            "enum": [
              "floor",
              "standard",
              "opportunistic"
            ]
          },
          "weight": {
            "type": "number"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fallback_stage": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
